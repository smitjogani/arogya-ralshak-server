generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String
  fullName     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  policies     Policy[]
  analyses     FinancialAnalysis[]
}

model Policy {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  providerName    String
  policyNumber    String
  sumInsured      Decimal             @db.Decimal(12, 2)
  roomRentLimit   Decimal             @db.Decimal(12, 2)
  coPayPercentage Decimal             @db.Decimal(5, 2)
  deductible      Decimal             @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses        FinancialAnalysis[]

  @@unique([userId, policyNumber])
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

model FinancialAnalysis {
  id                      String              @id @default(uuid()) @db.Uuid
  userId                  String              @db.Uuid
  policyId                String              @db.Uuid
  hospitalName            String
  totalBilledAmount       Decimal             @db.Decimal(12, 2)
  estimatedInsuranceCover Decimal             @db.Decimal(12, 2)
  estimatedOutOfPocket    Decimal             @db.Decimal(12, 2)
  encryptedJsonSummary    String              @db.Text
  status                  AnalysisStatus      @default(PENDING)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy                  Policy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  lineItems               BillLineItem[]
  redFlags                RedFlag[]
  suggestedQuestions      SuggestedQuestion[]
}

model BillLineItem {
  id                  String            @id @default(uuid()) @db.Uuid
  financialAnalysisId String            @db.Uuid
  description         String
  amount              Decimal           @db.Decimal(12, 2)
  category            String
  isCovered           Boolean
  reasonIfNotCovered  String?
  createdAt           DateTime          @default(now())

  financialAnalysis   FinancialAnalysis @relation(fields: [financialAnalysisId], references: [id], onDelete: Cascade)
}

model RedFlag {
  id                  String            @id @default(uuid()) @db.Uuid
  financialAnalysisId String            @db.Uuid
  severity            String
  description         String
  createdAt           DateTime          @default(now())

  financialAnalysis   FinancialAnalysis @relation(fields: [financialAnalysisId], references: [id], onDelete: Cascade)
}

model SuggestedQuestion {
  id                  String            @id @default(uuid()) @db.Uuid
  financialAnalysisId String            @db.Uuid
  questionText        String
  context             String
  createdAt           DateTime          @default(now())

  financialAnalysis   FinancialAnalysis @relation(fields: [financialAnalysisId], references: [id], onDelete: Cascade)
}
