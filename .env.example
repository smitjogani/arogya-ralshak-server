# ==============================================================
# Aarogya-Rakshak Backend - Environment Configuration Reference
# ==============================================================

# --------------------------------------------------------------
# 1. Server Configuration
# --------------------------------------------------------------
# The port the Express server will listen on
PORT=3000

# The environment mode (development, production, testing)
NODE_ENV="development"

# --------------------------------------------------------------
# 2. Database & Cache Connections
# --------------------------------------------------------------
# PostgreSQL connection string (must include username, password, host, port, db name)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/aarogya_rakshak?schema=public"

# Redis connection string for BullMQ (async workers)
REDIS_URL="redis://localhost:6379"

# --------------------------------------------------------------
# 3. Security & Cryptography (E2EE)
# --------------------------------------------------------------
# JWT Secret for signing authentication tokens (Must be a long random string)
JWT_SECRET="your_highly_secure_jwt_secret_change_in_production_123"

# AES-256 GCM Encryption Key (CRITICAL: MUST be exactly 32 characters/bytes)
# Used for End-to-End Encryption of API Payloads
AES_ENCRYPTION_KEY="12345678901234567890123456789012"

# --------------------------------------------------------------
# 4. API Keys & External Services (AI/ML)
# --------------------------------------------------------------
# Google Gemini API Key for AI Analysis (Get from Google AI Studio)
GEMINI_API_KEY="AIzaSy-your-gemini-api-key"

# Path to the Google Cloud Service Account JSON file for Vision OCR
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/your/service-account-file.json"

# --------------------------------------------------------------
# 5. Network Perimeter Security
# --------------------------------------------------------------
# CORS Allowed Origins (Comma separated). Use "*" for development.
# Example production value: "https://aarogya-rakshak.com,https://app.aarogya-rakshak.com"
ALLOWED_ORIGINS="*"

# Rate Limiter settings for /api routes
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQS="100"     # Max 100 requests per IP per window
